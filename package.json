{
  "name": "resilix-demo",
  "version": "1.0.0",
  "description": "Production demo application demonstrating the Resilix retry & resilience package in a full-stack Node.js and React architecture",
  "private": true,
  "scripts": {
    "start": "node start-demo.js",
    "dev": "node start-demo.js",
